<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sensors above 200 Hz. Without it, Android 12+ throws when a debug build asks for
         SENSOR_DELAY_FASTEST, and silently caps release builds at 200 Hz. -->
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <!-- A Wi-Fi lock while streaming, so power saving does not delay packets. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:label="Smartphone HMD"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
